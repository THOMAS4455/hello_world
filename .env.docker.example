# Docker Compose 环境变量模板
# 用法：copy .env.docker.example .env.docker  然后填入真实值（.env.docker 已加入 .gitignore）
# docker compose 会自动读取 .env；若使用 .env.docker，请复制为 .env 或加 --env-file .env.docker

# 必填：PostgreSQL
POSTGRES_DB=stock_prediction
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=change_me

# 必填：AI 服务
DEEPSEEK_API_KEY=change_me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 必填：Grafana 管理密码
GF_SECURITY_ADMIN_PASSWORD=change_me
