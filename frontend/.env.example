# 前端环境变量配置示例
# 复制此文件为 .env 并填入实际值

# API配置
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000/ws

# 应用配置
REACT_APP_NAME=股票预测系统
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=基于AI的股票预测系统

# 功能开关
REACT_APP_ENABLE_AI_CHAT=true
REACT_APP_ENABLE_REAL_TIME=true
REACT_APP_ENABLE_PREDICTION=true
REACT_APP_ENABLE_SENTIMENT=true

# 演示配置
REACT_APP_DEMO_MODE=false
REACT_APP_AUTO_REFRESH_INTERVAL=30000

# 图表配置
REACT_APP_CHART_ANIMATION=true
REACT_APP_CHART_THEME=light

# 调试配置
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=warn
